{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": { "includes": ["src/**", "tests/**", "*.js", "*.json", "!package-lock.json"] },
  "formatter": { "useEditorconfig": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}